# Copy to .env. Keep .env private and out of source control.
HOST=0.0.0.0
PORT=8787
DB_PATH=data/jigsaw.sqlite
OPERATOR_USER=operator
# Set a unique password of at least 10 characters before account setup.
OPERATOR_PASSWORD=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DISCONNECT_GRACE_MS=10000
# Optional direct trusted HTTPS. Use certificate/key paths issued for the host.
# TLS_CERT=C:/certificates/booth-cert.pem
# TLS_KEY=C:/certificates/booth-key.pem
# EVALUATION_SEEDS=24

# Vercel/cloud: external PostgreSQL pooled TLS connection, server-side only.
# Never prefix database credentials with VITE_. SQLite remains local-only.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# For local cloud testing: npm run cloud:migrate; npm run cloud:start
# CLOUD_TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DEDICATED_TEST_DB
