{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "server/**/*.ts",
    "src/engine.ts",
    "src/world.ts",
    "src/data.ts",
    "src/protocol.ts",
    "api/**/*.ts"
  ],
  "exclude": [
    "server/**/*.test.ts",
    "src/**/*.test.ts",
    "server/cloud/testDatabase.ts"
  ]
}
